<resources>
    <style name="SearchViewGold" parent="Widget.AppCompat.SearchView">
        <item name="android:textColor">@color/gold</item>
        <item name="android:editTextColor">@color/gold</item>
        <item name="android:textColorHint">#70D4AF37</item>
        <item name="android:textAppearance">@style/GoldText</item>
    </style>
    <style name="BlackStatusBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/gold</item>
        <item name="colorPrimaryDark">@color/black</item>
        <item name="colorAccent">@color/gold</item>
        <item name="android:colorPrimaryDark">@color/black</item>
        <item name="android:colorPrimary">@color/gold</item>
        <item name="actionModeSplitBackground">@color/gold</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:navigationBarColor">@color/black</item>
    </style>
    <style name="Base.ThemeOverlay.AppCompat.Dark.NoActionBar" parent="Base.ThemeOverlay.AppCompat.Dark">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>