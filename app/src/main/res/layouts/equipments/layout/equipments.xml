<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coord"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".equipment.EquipmentActivity"
    android:background="@drawable/neutralbg"
    android:theme="@style/Theme.Swtrial2.AppBarOverlay">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/fade_black_appbar_background"
        android:layout_width="match_parent"
        android:layout_height="50dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <com.amachewrs.sw5ecompanionapp.widget.BackButton
            android:id="@+id/BackButton"
            android:layout_width="70dp"
            android:layout_height="match_parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:fontFamily="@font/starjedi"
            android:textColor="@color/gold"
            android:autoSizeMaxTextSize="26sp"
            android:autoSizeMinTextSize="16sp"
            android:autoSizeTextType="uniform"
            android:autoSizeStepGranularity="1dp"
            android:textAlignment="center"
            android:gravity="center"
            android:translationZ="3dp"
            android:paddingTop="5dp"
            android:layout_marginHorizontal="70dp"
            android:text="Equipment HuB"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contentcl"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="50dp"
        android:paddingBottom="25dp">

        <com.amachewrs.sw5ecompanionapp.widget.EquipmentButton
            android:id="@+id/info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:onClick="openequipment"
            app:background="@drawable/equipmentinfo"
            app:layout_constraintBottom_toTopOf="@+id/all"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.5"
            app:text="Equipment info" />

        <com.amachewrs.sw5ecompanionapp.widget.EquipmentButton
            android:id="@+id/all"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:onClick="openequipment"
            app:background="@drawable/equipmentalltasa"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/info"
            app:layout_constraintVertical_bias="0.5"
            app:text="Equipment List" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>