<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:id="@+id/relayout"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="50dp"
    android:foreground="?android:attr/selectableItemBackground">

    <TextView
        android:id="@+id/table_specietext"
        android:layout_width="0dp"
        android:layout_height="30dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="1dp"
        android:layout_toStartOf="@+id/table_specieExpansion"
        android:autoSizeMaxTextSize="18dp"
        android:autoSizeMinTextSize="12dp"
        android:autoSizeStepGranularity="1dp"
        android:autoSizeTextType="uniform"
        android:fontFamily="@font/starjedi"
        android:letterSpacing="0.1"
        android:textAlignment="viewStart"
        android:textColor="@color/gold"
        tools:text="name stuff" />

    <TextView
        android:id="@+id/table_specieExpansion"
        android:layout_width="40dp"
        android:layout_height="30dp"
        android:layout_centerVertical="true"
        android:paddingBottom="2dp"
        android:layout_toStartOf="@+id/specie_fav"
        android:autoSizeMaxTextSize="18dp"
        android:autoSizeMinTextSize="12dp"
        android:autoSizeStepGranularity="1dp"
        android:autoSizeTextType="uniform"
        android:fontFamily="@font/starjedi"
        android:letterSpacing="0.1"
        android:textAlignment="gravity"
        android:gravity="center"
        android:textColor="@color/gold"
        tools:text="PHB" />

    <ImageButton
        android:id="@+id/specie_fav"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_marginEnd="20dp"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"
        android:contentDescription="@string/species_fav_contentdescription"
        android:foreground="@drawable/favouritegold"
        android:background="#00000000" />
</RelativeLayout>