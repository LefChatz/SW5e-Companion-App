<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:id="@+id/specie_info_template_ll">

    <ImageView
        android:id="@+id/specie_image"
        android:layout_width="match_parent"
        android:layout_height="600dp"
        android:src="@drawable/error404"
        android:contentDescription="Species example" />

    <TableLayout
        android:id="@+id/species_table"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/species_table_background"
        android:stretchColumns="2"
        android:shrinkColumns="1"
        android:padding="3dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:src="@drawable/gold_horizontal_line" />

        <TextView
            android:id="@+id/species_table_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Specie"
            android:textColor="@color/gold"
            android:fontFamily="@font/starjedi"
            android:textSize="27sp" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="7dp"
            android:src="@drawable/gold_horizontal_line" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="visual characteristics"
            android:textColor="@color/gold"
            android:textSize="18sp"
            android:fontFamily="@font/starjedi" />

        <TableRow android:background="#50D4AF37">

            <TextView
                android:id="@+id/species_skin_colour_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Skin Colour:"
                android:textColor="@color/gold"
                android:textSize="20sp"
                android:paddingEnd="20dp"
                android:textStyle="italic"
                android:layout_gravity="center_vertical" />

            <TextView
                android:id="@+id/species_skin_colour"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="skin colour"
                android:textColor="@color/gold"
                android:textSize="20sp"
                android:layout_span="2" />
        </TableRow>

        <TableRow>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="Hair Colour:"
                android:textColor="@color/gold"
                android:textSize="20sp"
                android:paddingEnd="20dp"
                android:textStyle="italic" />

            <TextView
                android:id="@+id/species_hair_colour"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="hair colour"
                android:textColor="@color/gold"
                android:textSize="20sp" />
        </TableRow>

        <TableRow android:background="#50D4AF37">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="Eye Colour:"
                android:textColor="@color/gold"
                android:textSize="20sp"
                android:paddingEnd="20dp"
                android:textStyle="italic" />

            <TextView
                android:id="@+id/species_eye_colour"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="eye colour"
                android:textColor="@color/gold"
                android:textSize="20sp" />
        </TableRow>

        <TableRow >

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="Distinctions:"
                android:textColor="@color/gold"
                android:textSize="20sp"
                android:paddingEnd="20dp"
                android:textStyle="italic"/>

            <TextView
                android:id="@+id/species_distinctions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="distinctions"
                android:textColor="@color/gold"
                android:textSize="20sp"
                android:layout_span="2" />
        </TableRow>

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="7dp"
            android:src="@drawable/gold_horizontal_line" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="physical characteristics"
            android:textColor="@color/gold"
            android:textSize="18sp"
            android:fontFamily="@font/starjedi" />

        <TableRow android:background="#50D4AF37">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Height:"
                android:textColor="@color/gold"
                android:textSize="20sp"
                android:paddingEnd="10dp"
                android:textStyle="italic" />

            <TextView
                android:id="@+id/species_height"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="height"
                android:textColor="@color/gold"
                android:textSize="20sp"
                android:paddingStart="10dp"
                android:paddingEnd="30dp"
                android:textAlignment="center" />

            <TextView
                android:id="@+id/species_height_plus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="height_plus"
                android:textColor="@color/gold"
                android:textSize="20sp"
                android:textAlignment="center" />

        </TableRow>

        <TableRow >

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Weigth:"
                android:textColor="@color/gold"
                android:textSize="20sp"
                android:paddingEnd="10dp"
                android:textStyle="italic" />

            <TextView
                android:id="@+id/species_weight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="weight"
                android:textColor="@color/gold"
                android:textSize="20sp"
                android:paddingStart="10dp"
                android:paddingEnd="30dp"
                android:textAlignment="center" />

            <TextView
                android:id="@+id/species_weight_plus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="weight_plus"
                android:textColor="@color/gold"
                android:textSize="20sp"
                android:textAlignment="center" />
        </TableRow>

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="7dp"
            android:src="@drawable/gold_horizontal_line" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sociocultural characteristics"
            android:textColor="@color/gold"
            android:textSize="18sp"
            android:fontFamily="@font/starjedi" />

        <TableRow android:background="#50D4AF37"
            android:id="@+id/species_homeworld_row">

            <TextView
                android:id="@+id/species_homeworld_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="Homeworld:"
                android:textColor="@color/gold"
                android:textSize="20sp"
                android:paddingEnd="10dp"
                android:textStyle="italic" />

            <TextView
                android:id="@+id/species_homeworld"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="homeworld"
                android:textColor="@color/gold"
                android:textSize="20sp"
                android:layout_span="2" />

        </TableRow>

        <TableRow android:id="@+id/species_language_row">

            <TextView
                android:id="@+id/species_language_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="Language:"
                android:textColor="@color/gold"
                android:textSize="20sp"
                android:paddingEnd="10dp"
                android:textStyle="italic" />

            <TextView
                android:id="@+id/species_language"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="language"
                android:textColor="@color/gold"
                android:textSize="20sp"
                android:layout_span="2"/>
        </TableRow>

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="5dp"
            android:src="@drawable/gold_horizontal_line" />
    </TableLayout>

    <TextView
        android:id="@+id/species_bio_and_app_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Biology and appearance"
        android:textColor="@color/gold"
        android:fontFamily="@font/starjedi"
        android:textSize="25sp" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:src="@drawable/gold_horizontal_line" />

    <TextView
        android:id="@+id/species_bio_and_app"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Specie Info 1"
        android:textColor="@color/gold"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/species_soc_and_cul_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Society and culture"
        android:textColor="@color/gold"
        android:fontFamily="@font/starjedi"
        android:textSize="25sp" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:src="@drawable/gold_horizontal_line" />

    <TextView
        android:id="@+id/species_soc_and_cul"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Specie info 2"
        android:textColor="@color/gold"
        android:textSize="20sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Names"
        android:textColor="@color/gold"
        android:fontFamily="@font/starjedi"
        android:textSize="25sp" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:src="@drawable/gold_horizontal_line" />

    <TextView
        android:id="@+id/species_names_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Specie info 3"
        android:textColor="@color/gold"
        android:textSize="20sp" />

    <TableLayout
        android:id="@+id/species_name_table"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:shrinkColumns="1"
        android:layout_marginStart="10dp">

        <TableRow
            android:id="@+id/species_male_name_row">

            <TextView
                android:id="@+id/species_male_names_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="Male Names:"
                android:textColor="@color/gold"
                android:textSize="20sp"
                android:textStyle="bold"
                android:paddingEnd="10dp"/>

            <TextView
                android:id="@+id/species_male_names"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Male Name, Also Male name, Another male name, The most male name"
                android:textColor="@color/gold"
                android:textSize="20sp" />
        </TableRow>

        <TableRow
            >

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="Female Names:"
                android:textColor="@color/gold"
                android:textSize="20sp"
                android:textStyle="bold"
                android:paddingEnd="20dp" />

            <TextView
                android:id="@+id/species_female_names"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Female Name, one more female name, still female name, so female name"
                android:textColor="@color/gold"
                android:textSize="20sp" />
        </TableRow>

        <TableRow
            android:id="@+id/species_surname_row">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="Surnames:"
                android:textColor="@color/gold"
                android:textSize="20sp"
                android:textStyle="bold"
                android:paddingEnd="20dp" />

            <TextView
                android:id="@+id/species_surnames"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Surname, sir Name,sher neim?, the last surname"
                android:textColor="@color/gold"
                android:textSize="20sp" />
        </TableRow>
    </TableLayout>
</LinearLayout>
